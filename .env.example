# Backend
# DO NOT commit real values. Copy to backend/.env and fill in.
DATABASE_URL="file:./prisma/dev.db"
PORT=3000

# Auth0
AUTH0_ISSUER=https://dev-yg.us.auth0.com/
AUTH0_AUDIENCE=https://bbl-candidate-test-api
AUTH0_CLIENT_ID=__set_in_local_env__
AUTH0_CLIENT_SECRET=__set_in_local_env__
AUTH0_CALLBACK_URL=http://localhost:3000/callback

# Frontend (Vite — must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH0_DOMAIN=dev-yg.us.auth0.com
VITE_AUTH0_CLIENT_ID=__set_in_local_env__
VITE_AUTH0_AUDIENCE=https://bbl-candidate-test-api
VITE_AUTH0_CALLBACK_URL=http://localhost:3000/callback

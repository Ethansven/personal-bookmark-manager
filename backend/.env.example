# Backend env — copy to backend/.env and fill in. NEVER commit real values.
DATABASE_URL="file:./dev.db"
# Note: with the Prisma SQLite provider, a `file:./x.db` URL is resolved
# relative to the prisma/ directory, so this lands at backend/prisma/dev.db.
PORT=3000

# Auth0
AUTH0_ISSUER=https://dev-yg.us.auth0.com/
AUTH0_AUDIENCE=https://bbl-candidate-test-api
AUTH0_CLIENT_ID=__set_in_local_env__
AUTH0_CLIENT_SECRET=__set_in_local_env__
AUTH0_CALLBACK_URL=http://localhost:3000/callback

# Used to sign express-session cookies. Pick any long random string.
SESSION_SECRET=__set_in_local_env__

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
